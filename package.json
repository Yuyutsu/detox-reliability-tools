{
  "name": "detox-reliability-tools",
  "version": "1.0.0",
  "description": "Utility library to improve reliability, stability, and debugging of Detox end-to-end tests for React Native applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "detox",
    "react-native",
    "testing",
    "e2e",
    "reliability",
    "flaky-tests",
    "retry",
    "stable",
    "ci"
  ],
  "author": "Yuyutsu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuyutsu/detox-reliability-tools.git"
  },
  "homepage": "https://github.com/Yuyutsu/detox-reliability-tools#readme",
  "bugs": {
    "url": "https://github.com/Yuyutsu/detox-reliability-tools/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "detox": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "detox": {
      "optional": true
    }
  }
}
